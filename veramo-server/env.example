# Environment variables for Veramo Identity Server
# Copy this file to .env and fill in your values

# Infura API key for Ethereum network access
# Get your API key from https://infura.io/
INFURA_API_KEY=your_infura_api_key_here

# Server port (default: 3000)
PORT=3000

# Database path (optional, defaults to ./database)
# DB_PATH=./database

# Upload directory (optional, defaults to ./uploads)
# UPLOAD_DIR=./uploads

# Network configuration (optional, defaults to sepolia)
# NETWORK=sepolia

